      "seed": 402,
      "version": 1,
      "versionNonce": 402,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1732694400000,
      "link": null,
      "locked": false,
      "text": "Color Coding:\n\n🔵 Authentication & Security (#2563eb)\n🟢 Master Data (#16a34a)\n🟣 General Ledger (#9333ea)\n🟠 AR & AP (#ea580c)\n🔵 Cash & Bank (#0d9488)\n🔴 Period Management (#dc2626)\n🟡 VAT & Compliance (#eab308)\n🔷 Reporting & Analytics (#4f46e5)\n⚫ System Administration (#6b7280)\n🟤 Audit (#92400e)\n💗 File Management (#ec4899)\n🔷 Import/Export (#06b6d4)\n🟩 AI Chatbot (#84cc16)\n\nActor Hierarchy:\nADMIN → CHIEF_ACCOUNTANT → CFO → ACCOUNTANT\n(Higher level inherits lower level permissions)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Color Coding:\n\n🔵 Authentication & Security (#2563eb)\n🟢 Master Data (#16a34a)\n🟣 General Ledger (#9333ea)\n🟠 AR & AP (#ea580c)\n🔵 Cash & Bank (#0d9488)\n🔴 Period Management (#dc2626)\n🟡 VAT & Compliance (#eab308)\n🔷 Reporting & Analytics (#4f46e5)\n⚫ System Administration (#6b7280)\n🟤 Audit (#92400e)\n💗 File Management (#ec4899)\n🔷 Import/Export (#06b6d4)\n🟩 AI Chatbot (#84cc16)\n\nActor Hierarchy:\nADMIN → CHIEF_ACCOUNTANT → CFO → ACCOUNTANT\n(Higher level inherits lower level permissions)"
    },

    {
      "id": "vn-note-title",
      "type": "text",
      "x": 800,
      "y": 600,
      "width": 500,
      "height": 500,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
