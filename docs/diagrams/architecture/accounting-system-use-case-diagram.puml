@startuml Accounting System Use Case Diagram

' Title and formatting
title Accounting System - Use Case Diagram
skinparam backgroundColor #f9fbff
skinparam handwritten false
skinparam defaultFontName Arial
skinparam participantPadding 20
skinparam useCase {
    BackgroundColor #e3f2fd
    BorderColor #1976d2
    FontColor #0d1b2a
    FontSize 14
}
skinparam actor {
    BackgroundColor #e3f2fd
    BorderColor #1976d2
    FontColor #0d1b2a
    FontSize 12
}
skinparam rectangle {
    BackgroundColor transparent
    BorderColor #1976d2
    FontColor #1976d2
    FontSize 20
}

' System boundary
rectangle "Accounting System" {
    ' Main Use Cases
    (Manage Vouchers) as ManageVouchers
    (User Management) as UserManagement
    (Company Settings) as CompanySettings
    (Financial Reports) as FinancialReports
    (Period Management) as PeriodManagement
    (Chart of Accounts) as ChartAccounts
    (Purchase Bills) as PurchaseBills
    (Payments) as Payments
    (Audit Trail) as AuditTrail

    ' Sub-features (extended/included use cases)
    (Post Voucher) as PostVoucher <<include>>
    (Validate Entries) as ValidateEntries <<include>>
    (Export to PDF) as ExportPDF <<extend>>
}

' Actors
actor "System Administrator" as Admin
actor "Finance Manager" as Manager
actor "Accountant" as Accountant
actor "Auditor" as Auditor
actor "Supplier Portal" as Supplier

' Inheritance relationships between actors
Admin <|-- Manager : inherits
Manager <|-- Accountant : inherits

' Actor to Use Case associations
Admin --> UserManagement
Admin --> CompanySettings
Manager --> FinancialReports
Manager --> PeriodManagement
Accountant --> ManageVouchers
Accountant --> ChartAccounts
Accountant --> PurchaseBills
Accountant --> Payments
Auditor --> AuditTrail
Supplier --> PurchaseBills
Supplier --> Payments

' Include and Extend relationships
ManageVouchers ..> PostVoucher : <<include>>
PostVoucher ..> ValidateEntries : <<include>>
FinancialReports ..> ExportPDF : <<extend>>

' Add notes for clarity
note right of PostVoucher
  Post operation requires
  validation of entries
end note

note right of ExportPDF
  Optional extension for
  report generation
end note

note top of Manager
  Financial Manager role
  with approval capabilities
end note

' Legend for relationships
legend right
  **Legend:**
  **━━** Association (Actor → Use Case)
  **..** Include/Extend (Use Case → Use Case)
  **◁──** Inheritance (Actor → Actor)
  **<<include>>** Mandatory inclusion
  **<<extend>>** Optional extension
end legend

@enduml