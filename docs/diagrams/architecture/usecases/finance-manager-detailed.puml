@startuml Finance Manager - Detailed Use Cases

' Finance Manager Use Case Diagram
title Finance Manager - Detailed Use Cases
skinparam backgroundColor #f9fbff
skinparam usecaseBackgroundColor #fff3e0
skinparam usecaseBorderColor #f57c00
skinparam actorBackgroundColor #e3f2fd
skinparam actorBorderColor #1976d2

' Finance Manager actor
actor "Finance Manager" as Manager

' System boundary for Finance Manager functions
rectangle "Financial Management Module" {
    ' Financial Reporting Use Cases
    usecase "Generate Balance Sheet" as BalanceSheet
    usecase "Generate Income Statement" as IncomeStatement
    usecase "Generate Cash Flow Statement" as CashFlow
    usecase "Create Custom Reports" as CustomReports
    usecase "Export Financial Reports" as ExportReports
    usecase "Schedule Report Generation" as ScheduleReports

    ' Period Management Use Cases
    usecase "Open Accounting Period" as OpenPeriod
    usecase "Close Accounting Period" as ClosePeriod
    usecase "Reopen Closed Period" as ReopenPeriod
    usecase "Manage Period Locking" as PeriodLocking
    usecase "Review Period Adjustments" as ReviewAdjustments

    ' Approval and Review Use Cases
    usecase "Approve Large Transactions" as ApproveLargeTx
    usecase "Review Voucher Batches" as ReviewVouchers
    usecase "Approve Journal Entries" as ApproveEntries
    usecase "Review Budget Variance" as BudgetVariance
    usecase "Authorize Period Closing" as AuthorizeClosing

    ' Budget Management Use Cases
    usecase "Create Annual Budget" as CreateBudget
    usecase "Monitor Budget Performance" as MonitorBudget
    usecase "Adjust Budget Allocations" as AdjustBudget
    usecase "Generate Budget Reports" as BudgetReports

    ' Compliance and Control Use Cases
    usecase "Review Internal Controls" as ReviewControls
    usecase "Monitor Compliance Metrics" as ComplianceMetrics
    usecase "Generate Compliance Reports" as ComplianceReports
    usecase "Review Audit Trails" as ReviewAuditTrails

    ' Dashboard and Analytics Use Cases
    usecase "View Financial Dashboard" as Dashboard
    usecase "Analyze Financial Ratios" as RatioAnalysis
    usecase "Monitor Key Performance Indicators" as KPIs
    usecase "Create Financial Forecasts" as Forecasts
}

' Connections
Manager --> BalanceSheet
Manager --> IncomeStatement
Manager --> CashFlow
Manager --> CustomReports
Manager --> ExportReports
Manager --> ScheduleReports

Manager --> OpenPeriod
Manager --> ClosePeriod
Manager --> ReopenPeriod
Manager --> PeriodLocking
Manager --> ReviewAdjustments

Manager --> ApproveLargeTx
Manager --> ReviewVouchers
Manager --> ApproveEntries
Manager --> BudgetVariance
Manager --> AuthorizeClosing

Manager --> CreateBudget
Manager --> MonitorBudget
Manager --> AdjustBudget
Manager --> BudgetReports

Manager --> ReviewControls
Manager --> ComplianceMetrics
Manager --> ComplianceReports
Manager --> ReviewAuditTrails

Manager --> Dashboard
Manager --> RatioAnalysis
Manager --> KPIs
Manager --> Forecasts

' Include relationships
ClosePeriod ..> ReviewAdjustments : <<include>>
ClosePeriod ..> AuthorizeClosing : <<include>>
ApproveLargeTx ..> ReviewVouchers : <<include>>
CustomReports ..> ExportReports : <<include>>
ComplianceReports ..> ReviewAuditTrails : <<include>>

' Extension relationships
ExportReports ..> "Export to Excel" : <<extend>>
ExportReports ..> "Export to PDF" : <<extend>>
Dashboard ..> "Create Custom Dashboard" : <<extend>>
MonitorBudget ..> "Set Budget Alerts" : <<extend>>

' Notes for clarity
note right of Manager
  **Finance Manager**
  - Financial oversight
  - Period management
  - Approval authority
  - Strategic reporting
end note

note bottom of ClosePeriod
  Requires validation of
  all period transactions
  and management approval
end note

note bottom of ApproveLargeTx
  For transactions exceeding
  predefined threshold limits
end note

@enduml