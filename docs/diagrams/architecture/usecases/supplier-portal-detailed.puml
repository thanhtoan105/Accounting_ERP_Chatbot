@startuml Supplier Portal - Detailed Use Cases

' Supplier Portal Use Case Diagram
title Supplier Portal - Detailed Use Cases
skinparam backgroundColor #f9fbff
skinparam usecaseBackgroundColor #fff8e1
skinparam usecaseBorderColor #f9a825
skinparam actorBackgroundColor #e3f2fd
skinparam actorBorderColor #1976d2

' Supplier Portal actor
actor "Supplier Portal" as Supplier

' System boundary for Supplier Portal functions
rectangle "Supplier Integration Module" {
    ' Bill Submission Use Cases
    usecase "Submit New Bill" as SubmitBill
    usecase "Upload Bill Documents" as UploadDocuments
    usecase "Validate Bill Information" as ValidateBillInfo
    usecase "Track Bill Status" as TrackBillStatus
    usecase "Resubmit Rejected Bill" as ResubmitBill
    usecase "Withdraw Submitted Bill" as WithdrawBill

    ' Payment Information Use Cases
    usecase "View Payment Status" as ViewPaymentStatus
    usecase "Check Payment History" as CheckPaymentHistory
    usecase "Download Payment Remittance" as DownloadRemittance
    usecase "Update Payment Details" as UpdatePaymentDetails
    usecase "Set Payment Preferences" as PaymentPreferences

    ' Account Management Use Cases
    usecase "Register Supplier Account" as RegisterAccount
    usecase "Update Company Profile" as UpdateProfile
    usecase "Manage Contact Information" as ManageContacts
    usecase "Update Banking Details" as UpdateBanking
    usecase "Manage User Access" as ManageUserAccess

    ' Communication Use Cases
    usecase "Receive Notifications" as ReceiveNotifications
    usecase "Send Query Messages" as SendQueries
    usecase "Respond to Queries" as RespondToQueries
    usecase "Download Supporting Documents" as DownloadDocs
    usecase "Access Communication History" as CommunicationHistory

    ' Reporting Use Cases
    usecase "View Transaction Summary" as TransactionSummary
    usecase "Generate Aging Reports" as GenerateAgingReports
    usecase "Download Invoice History" as InvoiceHistory
    usecase "View Account Statements" as AccountStatements
    usecase "Export Financial Data" as ExportFinancialData

    ' Integration Use Cases
    usecase "API Bill Submission" as APISubmission
    usecase "Automated Invoice Processing" as AutomatedProcessing
    usecase "Real-time Status Updates" as RealTimeUpdates
    usecase "Electronic Data Interchange" as EDI
    usecase "System Health Check" as SystemHealth
}

' Connections
Supplier --> SubmitBill
Supplier --> UploadDocuments
Supplier --> ValidateBillInfo
Supplier --> TrackBillStatus
Supplier --> ResubmitBill
Supplier --> WithdrawBill

Supplier --> ViewPaymentStatus
Supplier --> CheckPaymentHistory
Supplier --> DownloadRemittance
Supplier --> UpdatePaymentDetails
Supplier --> PaymentPreferences

Supplier --> RegisterAccount
Supplier --> UpdateProfile
Supplier --> ManageContacts
Supplier --> UpdateBanking
Supplier --> ManageUserAccess

Supplier --> ReceiveNotifications
Supplier --> SendQueries
Supplier --> RespondToQueries
Supplier --> DownloadDocs
Supplier --> CommunicationHistory

Supplier --> TransactionSummary
Supplier --> GenerateAgingReports
Supplier --> InvoiceHistory
Supplier --> AccountStatements
Supplier --> ExportFinancialData

Supplier --> APISubmission
Supplier --> AutomatedProcessing
Supplier --> RealTimeUpdates
Supplier --> EDI
Supplier --> SystemHealth

' Include relationships
SubmitBill ..> UploadDocuments : <<include>>
SubmitBill ..> ValidateBillInfo : <<include>>
TrackBillStatus ..> ReceiveNotifications : <<include>>
CheckPaymentHistory ..> DownloadRemittance : <<include>>
AccountStatements ..> TransactionSummary : <<include>>

' Extension relationships
SubmitBill ..> "Submit Recurring Bill" : <<extend>>
ValidateBillInfo ..> "Validate Tax Information" : <<extend>>
ReceiveNotifications ..> "Set Notification Preferences" : <<extend>>
GenerateAgingReports ..> "Schedule Report Generation" : <<extend>>
ExportFinancialData ..> "Export to Accounting System" : <<extend>>

' Notes for clarity
note right of Supplier
  **Supplier Portal**
  - External system integration
  - Limited access permissions
  - Self-service capabilities
  - Automated processing
end note

note bottom of SubmitBill
  Supports various bill formats
  with automatic validation
  and document attachment
end note

note bottom of APISubmission
  For automated bill submission
  from supplier accounting systems
  with real-time processing
end note

' Security note
note bottom of Supplier
  **Security:** Limited to
  own company data only
  No access to other
  supplier information
end note

@enduml