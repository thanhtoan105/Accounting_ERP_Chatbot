@startuml Auditor - Detailed Use Cases

' Auditor Use Case Diagram
title Auditor - Detailed Use Cases
skinparam backgroundColor #f9fbff
skinparam usecaseBackgroundColor #f3e5f5
skinparam usecaseBorderColor #7b1fa2
skinparam actorBackgroundColor #e3f2fd
skinparam actorBorderColor #1976d2

' Auditor actor
actor "Auditor" as Auditor

' System boundary for Auditor functions
rectangle "Audit and Compliance Module" {
    ' Audit Trail Review Use Cases
    usecase "View Transaction History" as ViewHistory
    usecase "Track Transaction Changes" as TrackChanges
    usecase "Review User Activity Logs" as ReviewActivity
    usecase "Examine Modified Records" as ExamineModifications
    usecase "Verify Transaction Integrity" as VerifyIntegrity
    usecase "Generate Audit Timeline" as AuditTimeline

    ' Compliance Checking Use Cases
    usecase "Check Accounting Standards" as CheckStandards
    usecase "Verify Tax Compliance" as VerifyTaxCompliance
    usecase "Review Internal Controls" as ReviewControls
    usecase "Validate Period Closing" as ValidateClosing
    usecase "Check Regulatory Compliance" as CheckRegulatory

    ' Audit Reporting Use Cases
    usecase "Generate Audit Findings" as AuditFindings
    usecase "Create Exception Reports" as ExceptionReports
    usecase "Document Audit Observations" as DocumentObservations
    usecase "Generate Compliance Reports" as GenerateComplianceReports
    usecase "Create Audit Summary" as AuditSummary
    usecase "Export Audit Package" as ExportAuditPackage

    ' Investigation Use Cases
    usecase "Investigate Anomalies" as InvestigateAnomalies
    usecase "Trace Transaction Flow" as TraceTransaction
    usecase "Verify Document Attachments" as VerifyAttachments
    usecase "Cross-Reference Data" as CrossReference
    usecase "Validate Supporting Documents" as ValidateDocuments

    ' Read-Only Data Access Use Cases
    usecase "View Financial Statements" as ViewStatements
    usecase "Examine Account Balances" as ExamineBalances
    usecase "Review Trial Balance" as ReviewTrialBalance
    usecase "Access Historical Data" as AccessHistorical
    usecase "View Company Settings" as ViewCompanySettings
    usecase "Check User Permissions" as CheckPermissions

    ' Audit Tools Use Cases
    usecase "Use Audit Filters" as AuditFilters
    usecase "Apply Data Sampling" as DataSampling
    usecase "Generate Statistical Reports" as StatisticalReports
    usecase "Create Audit Workpapers" as CreateWorkpapers
    usecase "Manage Audit Evidence" as ManageEvidence
}

' Connections
Auditor --> ViewHistory
Auditor --> TrackChanges
Auditor --> ReviewActivity
Auditor --> ExamineModifications
Auditor --> VerifyIntegrity
Auditor --> AuditTimeline

Auditor --> CheckStandards
Auditor --> VerifyTaxCompliance
Auditor --> ReviewControls
Auditor --> ValidateClosing
Auditor --> CheckRegulatory

Auditor --> AuditFindings
Auditor --> ExceptionReports
Auditor --> DocumentObservations
Auditor --> GenerateComplianceReports
Auditor --> AuditSummary
Auditor --> ExportAuditPackage

Auditor --> InvestigateAnomalies
Auditor --> TraceTransaction
Auditor --> VerifyAttachments
Auditor --> CrossReference
Auditor --> ValidateDocuments

Auditor --> ViewStatements
Auditor --> ExamineBalances
Auditor --> ReviewTrialBalance
Auditor --> AccessHistorical
Auditor --> ViewCompanySettings
Auditor --> CheckPermissions

Auditor --> AuditFilters
Auditor --> DataSampling
Auditor --> StatisticalReports
Auditor --> CreateWorkpapers
Auditor --> ManageEvidence

' Include relationships
AuditFindings ..> InvestigateAnomalies : <<include>>
ExceptionReports ..> ReviewActivity : <<include>>
AuditSummary ..> DocumentObservations : <<include>>
ValidateClosing ..> ExamineModifications : <<include>>
CrossReference ..> TraceTransaction : <<include>>

' Extension relationships
ExportAuditPackage ..> "Generate PDF Audit Report" : <<extend>>
StatisticalReports ..> "Create Trend Analysis" : <<extend>>
CreateWorkpapers ..> "Attach Evidence Files" : <<extend>>
InvestigateAnomalies ..> "Report Suspicious Activity" : <<extend>>

' Notes for clarity
note right of Auditor
  **External Auditor**
  - Read-only access
  - Historical data review
  - Compliance verification
  - Audit documentation
end note

note bottom of InvestigateAnomalies
  Detailed investigation of
  unusual patterns or
  suspicious transactions
end note

note bottom of ExportAuditPackage
  Complete audit documentation
  with evidence and findings
end note

' Security note
note bottom of Auditor
  **Important:** Auditor has
  read-only permissions
  No modification capabilities
end note

@enduml