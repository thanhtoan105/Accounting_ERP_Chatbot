@startuml System Administrator - Detailed Use Cases

' System Administrator Use Case Diagram
title System Administrator - Detailed Use Cases
skinparam backgroundColor #f9fbff
skinparam usecaseBackgroundColor #e3f2fd
skinparam usecaseBorderColor #1976d2
skinparam actorBackgroundColor #e8f5e9
skinparam actorBorderColor #388e3c

' Main System Administrator actor
actor "System Administrator" as Admin

' System boundary for Admin functions
rectangle "System Administration Module" {
    ' User Management Use Cases
    usecase "Create User Account" as CreateUser
    usecase "Update User Profile" as UpdateUser
    usecase "Deactivate User Account" as DeactivateUser
    usecase "Reset User Password" as ResetPassword
    usecase "Assign User Roles" as AssignRoles
    usecase "Manage User Permissions" as ManagePermissions

    ' Company Management Use Cases
    usecase "Configure Company Settings" as CompanySettings
    usecase "Manage Company Profile" as CompanyProfile
    usecase "Set Fiscal Year" as SetFiscalYear
    usecase "Configure Tax Settings" as TaxSettings
    usecase "Manage Currency Settings" as CurrencySettings

    ' System Configuration Use Cases
    usecase "Configure Email Settings" as EmailSettings
    usecase "Manage Backup Settings" as BackupSettings
    usecase "Configure Security Policies" as SecurityPolicies
    usecase "Manage System Notifications" as SystemNotifications
    usecase "View System Logs" as ViewLogs

    ' Multi-tenancy Use Cases
    usecase "Create New Company" as CreateCompany
    usecase "Manage Company Subscriptions" as ManageSubscriptions
    usecase "Monitor Resource Usage" as MonitorUsage
    usecase "Tenant Isolation Management" as TenantManagement
}

' Connections
Admin --> CreateUser
Admin --> UpdateUser
Admin --> DeactivateUser
Admin --> ResetPassword
Admin --> AssignRoles
Admin --> ManagePermissions

Admin --> CompanySettings
Admin --> CompanyProfile
Admin --> SetFiscalYear
Admin --> TaxSettings
Admin --> CurrencySettings

Admin --> EmailSettings
Admin --> BackupSettings
Admin --> SecurityPolicies
Admin --> SystemNotifications
Admin --> ViewLogs

Admin --> CreateCompany
Admin --> ManageSubscriptions
Admin --> MonitorUsage
Admin --> TenantManagement

' Include relationships (complex operations include basic ones)
ManagePermissions ..> AssignRoles : <<include>>
ManagePermissions ..> UpdateUser : <<include>>
CreateCompany ..> CompanySettings : <<include>>
TenantManagement ..> MonitorUsage : <<include>>

' Extension relationships
ViewLogs ..> "Export System Logs" : <<extend>>
ManageSubscriptions ..> "Upgrade Subscription Plan" : <<extend>>
SecurityPolicies ..> "Configure Two-Factor Auth" : <<extend>>

' Notes for clarity
note right of Admin
  **System Administrator**
  - Full system access
  - Multi-tenant management
  - Security and configuration
end note

note bottom of CreateUser
  Includes email verification
  and default role assignment
end note

note bottom of CreateCompany
  Creates new tenant with
  default configuration
end note

@enduml