        {
            "id": "format-response",
            "name": "Format Response",
            "parameters": {
                "jsCode": "const agentOutput = $input.first().json;\nconst params = $('Extract Query Parameters').first().json;\nconst startTime = parseInt(params.start_time);\nconst responseTimeMs = Date.now() - startTime;\n\nconst answer = agentOutput.output || agentOutput.text || 'Không thể xử lý câu hỏi. Vui lòng thử lại.';\n\n// Extract voucher numbers from answer text\nlet citations = [];\nconst voucherPattern = /(?:PC|PT|HĐ|PK)-\\d{4}-\\d{3}/gi;\nconst matches = answer.match(voucherPattern) || [];\nconst uniqueVouchers = [...new Set(matches)];\n\ncitations = uniqueVouchers.map((voucherNumber, idx) => ({\n  entityType: 'VOUCHER',\n  entityId: `extracted-${idx}`,\n  voucherNumber: voucherNumber,\n  excerpt: `Trích dẫn từ câu trả lời`,\n  relevanceScore: 0.85,\n  link: `/vouchers?search=${voucherNumber}`\n}));\n\n// Calculate confidence based on citations found\nlet confidenceScore = 0.5;\nif (citations.length > 0) {\n  confidenceScore = Math.min(0.6 + (citations.length * 0.1), 0.95);\n}\n\nlet confidenceBadge = 'LOW';\nif (confidenceScore >= 0.8) confidenceBadge = 'HIGH';\nelse if (confidenceScore >= 0.5) confidenceBadge = 'MEDIUM';\n\nconst response = {\n  answer: answer,\n  citations: citations.slice(0, 10),\n  confidenceScore: Math.round(confidenceScore * 100) / 100,\n  confidenceBadge: confidenceBadge,\n  queryId: `q_${params.session_id}_${Date.now()}`,\n  sessionId: params.session_id,\n  responseTimeMs: responseTimeMs,\n  language: params.language,\n  timestamp: new Date().toISOString()\n};\n\nif (citations.length === 0 && !answer.includes('PC-') && !answer.includes('PT-')) {\n  response.suggestions = [\n    'Thử hỏi cụ thể hơn về số phiếu hoặc ngày tháng',\n    'Kiểm tra lại tên tài khoản hoặc đối tượng',\n    'Liên hệ bộ phận hỗ trợ nếu cần trợ giúp thêm'\n  ];\n}\n\nreturn [{ json: response }];"
            },
            "position": [1280, 208],
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "onError": "continueRegularOutput"
        },
