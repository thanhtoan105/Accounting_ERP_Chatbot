						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"Duplicate User\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Test duplicate email validation (run after Register - Success)"
					},
					"response": []
				},
				{
					"name": "Register - Invalid Email Format",
					"event": [
						{
							"listen": "test",
