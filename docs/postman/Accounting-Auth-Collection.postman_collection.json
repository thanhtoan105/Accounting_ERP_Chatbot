		{
			"name": "Auth - Login",
			"item": [
				{
					"name": "Login - Success",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has data object\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('accessToken');",
									"    pm.expect(jsonData.data).to.have.property('user');",
									"});",
									"",
									"pm.test(\"Access token is not empty\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.accessToken).to.not.be.empty;",
									"});",
									"",
									"pm.test(\"Refresh token cookie is set\", function () {",
									"    var cookies = pm.cookies.all();",
									"    var hasRefreshToken = false;",
									"    for (var i = 0; i < cookies.length; i++) {",
									"        if (cookies[i].name === 'refreshToken') {",
									"            hasRefreshToken = true;",
									"            pm.collectionVariables.set('refreshToken', cookies[i].value);",
									"            break;",
									"        }",
									"    }",
									"    pm.expect(hasRefreshToken).to.be.true;",
									"});",
									"",
									"// Store access token",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"rememberMe\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login with valid credentials. Requires user to be registered first."
					},
					"response": []
				},
				{
					"name": "Login - With Remember Me",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Refresh token cookie has extended expiry\", function () {",
									"    var cookies = pm.cookies.all();",
									"    for (var i = 0; i < cookies.length; i++) {",
									"        if (cookies[i].name === 'refreshToken') {",
									"            // Cookie with rememberMe should have longer max-age",
									"            pm.expect(cookies[i].maxAge).to.be.greaterThan(7 * 24 * 60 * 60);",
									"        }",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"rememberMe\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login with remember me checked"
					},
					"response": []
				},
				{
					"name": "Login - Invalid Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Response has error object\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('error');",
									"    pm.expect(jsonData.error.code).to.eql('UNAUTHORIZED');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Test login with wrong password"
					},
					"response": []
				},
				{
					"name": "Login - Account Lockout (5 Failed Attempts)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// This test simulates account lockout",
									"// After 5 failed attempts, account should be locked",
									"pm.test(\"Status code is 423 or 401\", function () {",
									"    pm.expect([401, 423]).to.include(pm.response.code);",
									"});",
									"",
									"pm.test(\"Response has error object\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('error');",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// This is a manual test - run this request 5 times",
									"// After 5 failed attempts, try login with correct password",
									"// It should return 423 Locked",
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"lockout@example.com\",\n  \"password\": \"WrongPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Test account lockout. Run this 5 times, then try login with correct password. Should return 423 Locked."
					},
					"response": []
				}
			]
		},
		{
			"name": "Auth - Refresh Token",
			"item": [
				{
					"name": "Refresh - Success",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has new access token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('accessToken');",
									"    pm.expect(jsonData.data.accessToken).to.not.be.empty;",
									"});",
									"",
									"// Store new access token",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    var oldToken = pm.collectionVariables.get('accessToken');",
									"    var newToken = jsonData.data.accessToken;",
									"    pm.expect(newToken).to.not.eql(oldToken);",
									"    pm.collectionVariables.set('accessToken', newToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "refresh"]
						},
						"description": "Refresh access token using refresh token cookie. Requires login first."
					},
					"response": []
				},
				{
					"name": "Refresh - No Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Response has error object\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('error');",
									"    pm.expect(jsonData.error.code).to.eql('UNAUTHORIZED');",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Clear refresh token cookie",
									"pm.cookies.clear();"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "refresh"]
						},
						"description": "Test refresh without refresh token cookie"
					},
					"response": []
				}
			]
		},
		{
			"name": "Auth - Logout",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 204\", function () {",
							"    pm.response.to.have.status(204);",
							"});",
							"",
							"pm.test(\"Refresh token cookie is cleared\", function () {",
							"    var cookies = pm.cookies.all();",
							"    var hasRefreshToken = false;",
							"    for (var i = 0; i < cookies.length; i++) {",
							"        if (cookies[i].name === 'refreshToken' && cookies[i].maxAge === 0) {",
							"            hasRefreshToken = true;",
							"            break;",
							"        }",
							"    }",
							"    // Cookie should be cleared (maxAge = 0)",
							"    pm.expect(hasRefreshToken || cookies.length === 0).to.be.true;",
							"});",
							"",
							"// Clear tokens",
							"pm.collectionVariables.set('accessToken', '');",
							"pm.collectionVariables.set('refreshToken', '');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/logout",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "auth", "logout"]
				},
				"description": "Logout and clear refresh token cookie. Requires login first."
			},
			"response": []
		},
