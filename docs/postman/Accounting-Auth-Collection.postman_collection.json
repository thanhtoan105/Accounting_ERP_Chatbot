		{
			"name": "Auth - Register",
			"item": [
				{
					"name": "Register - Success",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has data object\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"});",
									"",
									"pm.test(\"Response contains user info\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data).to.have.property('email');",
									"    pm.expect(jsonData.data).to.have.property('fullName');",
									"    pm.expect(jsonData.data).to.have.property('role');",
									"    pm.expect(jsonData.data.role).to.eql('USER');",
									"});",
									"",
									"pm.test(\"Password not in response\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.not.have.property('password');",
									"    pm.expect(jsonData.data).to.not.have.property('passwordHash');",
									"});",
									"",
									"// Store user ID for later use",
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('userId', jsonData.data.id);",
									"    pm.collectionVariables.set('testEmail', jsonData.data.email);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"Test User\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Register a new user successfully"
					},
					"response": []
				},
				{
					"name": "Register - Weak Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Response has error object\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('error');",
									"    pm.expect(jsonData.error.code).to.eql('VALIDATION_ERROR');",
									"});",
									"",
									"pm.test(\"Error message mentions password\", function () {",
									"    var jsonData = pm.response.json();",
									"    var errorDetails = jsonData.error.details || {};",
									"    var hasPasswordError = false;",
									"    for (var key in errorDetails) {",
									"        if (key === 'password' || errorDetails[key].toLowerCase().includes('password')) {",
									"            hasPasswordError = true;",
									"        }",
									"    }",
									"    pm.expect(hasPasswordError).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"weak@example.com\",\n  \"password\": \"weak\",\n  \"fullName\": \"Weak User\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Test validation with weak password"
					},
					"response": []
				},
				{
					"name": "Register - Duplicate Email",
