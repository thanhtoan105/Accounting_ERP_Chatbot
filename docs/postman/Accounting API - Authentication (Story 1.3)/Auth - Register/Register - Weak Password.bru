meta {
  name: Register - Weak Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "weak@example.com",
    "password": "weak",
    "fullName": "Weak User"
  }
}

script:post-response {
  test("Status code is 400", function () {
      expect(res.getStatus()).to.equal(400);
  });
  
  test("Response has error object", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('error');
      expect(jsonData.error.code).to.eql('VALIDATION_ERROR');
  });
  
  test("Error message mentions password", function () {
      var jsonData = res.getBody();
      var errorDetails = jsonData.error.details || {};
      var hasPasswordError = false;
      for (var key in errorDetails) {
          if (key === 'password' || errorDetails[key].toLowerCase().includes('password')) {
              hasPasswordError = true;
          }
      }
      expect(hasPasswordError).to.be.true;
  });
}

settings {
  encodeUrl: true
}

docs {
  Test validation with weak password
}
