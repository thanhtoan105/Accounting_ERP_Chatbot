meta {
  name: Register - Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "{{testPassword}}",
    "fullName": "Test User"
  }
}

script:post-response {
  test("Status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  test("Response has data object", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('data');
  });
  
  test("Response contains user info", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('id');
      expect(jsonData.data).to.have.property('email');
      expect(jsonData.data).to.have.property('fullName');
      expect(jsonData.data).to.have.property('role');
      expect(jsonData.data.role).to.eql('USER');
  });
  
  test("Password not in response", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.not.have.property('password');
      expect(jsonData.data).to.not.have.property('passwordHash');
  });
  
  // Store user ID for later use
  if (res.getStatus() === 201) {
      var jsonData = res.getBody();
      bru.setVar('userId', jsonData.data.id);
      bru.setVar('testEmail', jsonData.data.email);
  }
}

settings {
  encodeUrl: true
}

docs {
  Register a new user successfully
}
