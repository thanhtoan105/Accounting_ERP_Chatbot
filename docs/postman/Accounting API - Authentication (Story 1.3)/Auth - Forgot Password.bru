meta {
  name: Auth - Forgot Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{testEmail}}"
  }
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has success message", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('data');
      expect(jsonData.data).to.have.property('message');
  });
  
  test("Response does not reveal email existence", function () {
      var jsonData = res.getBody();
      // Message should be generic, not revealing if email exists
      expect(jsonData.data.message).to.include('reset link');
  });
}

settings {
  encodeUrl: true
}

docs {
  Request password reset. Always returns 200 to prevent email enumeration.
}
