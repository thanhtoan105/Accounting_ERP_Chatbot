meta {
  name: Auth - Logout
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("Status code is 204", function () {
      expect(res.getStatus()).to.equal(204);
  });
  
  test("Refresh token cookie is cleared", function () {
  //     var cookies = pm.cookies.all();
      var hasRefreshToken = false;
      for (var i = 0; i < cookies.length; i++) {
          if (cookies[i].name === 'refreshToken' && cookies[i].maxAge === 0) {
              hasRefreshToken = true;
              break;
          }
      }
      // Cookie should be cleared (maxAge = 0)
      expect(hasRefreshToken || cookies.length === 0).to.be.true;
  });
  
  // Clear tokens
  bru.setVar('accessToken', '');
  bru.setVar('refreshToken', '');
}

settings {
  encodeUrl: true
}

docs {
  Logout and clear refresh token cookie. Requires login first.
}
