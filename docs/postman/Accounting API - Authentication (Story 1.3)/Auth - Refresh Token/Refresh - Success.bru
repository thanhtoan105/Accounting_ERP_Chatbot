meta {
  name: Refresh - Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has new access token", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('data');
      expect(jsonData.data).to.have.property('accessToken');
      expect(jsonData.data.accessToken).to.not.be.empty;
  });
  
  // Store new access token
  if (res.getStatus() === 200) {
      var jsonData = res.getBody();
      var oldToken = bru.getVar('accessToken');
      var newToken = jsonData.data.accessToken;
      expect(newToken).to.not.eql(oldToken);
      bru.setVar('accessToken', newToken);
  }
}

settings {
  encodeUrl: true
}

docs {
  Refresh access token using refresh token cookie. Requires login first.
}
