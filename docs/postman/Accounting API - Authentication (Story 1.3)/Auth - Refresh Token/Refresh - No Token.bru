meta {
  name: Refresh - No Token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:pre-request {
  // Clear refresh token cookie
  // pm.cookies.clear();
}

script:post-response {
  test("Status code is 401", function () {
      expect(res.getStatus()).to.equal(401);
  });
  
  test("Response has error object", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('error');
      expect(jsonData.error.code).to.eql('UNAUTHORIZED');
  });
}

settings {
  encodeUrl: true
}

docs {
  Test refresh without refresh token cookie
}
