<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport name="company_profile" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="60">
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="COMPANY_TAX_CODE" class="java.lang.String"/>
    <parameter name="COMPANY_ADDRESS" class="java.lang.String"/>
    <parameter name="COMPANY_LOGO_URL" class="java.lang.String"/>
    <parameter name="COMPANY_CODE" class="java.lang.String"/>
    <parameter name="CONTACT_EMAIL" class="java.lang.String"/>
    <parameter name="CONTACT_PHONE" class="java.lang.String"/>
    <parameter name="FISCAL_YEAR_START" class="java.lang.String"/>

    <title>
        <band height="80">
            <textField>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Company Profile"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME} + " (" + $P{COMPANY_CODE} + ")"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="160">
            <textField>
                <reportElement x="0" y="0" width="555" height="18"/>
                <textFieldExpression><![CDATA["Tax Code: " + $P{COMPANY_TAX_CODE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="22" width="555" height="18"/>
                <textFieldExpression><![CDATA["Address: " + $P{COMPANY_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="44" width="555" height="18"/>
                <textFieldExpression><![CDATA["Email: " + $P{CONTACT_EMAIL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="66" width="555" height="18"/>
                <textFieldExpression><![CDATA["Phone: " + $P{CONTACT_PHONE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="88" width="555" height="18"/>
                <textFieldExpression><![CDATA["Fiscal Year Start: " + $P{FISCAL_YEAR_START}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="60">
            <image>
                <reportElement x="0" y="0" width="60" height="60"/>
                <imageExpression><![CDATA[$P{COMPANY_LOGO_URL}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="70" y="0" width="485" height="18"/>
                <textFieldExpression><![CDATA["Company: " + $P{COMPANY_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="20" width="485" height="18"/>
                <textFieldExpression><![CDATA["Tax: " + $P{COMPANY_TAX_CODE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="40" width="485" height="18"/>
                <textFieldExpression><![CDATA["Address: " + $P{COMPANY_ADDRESS}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>


