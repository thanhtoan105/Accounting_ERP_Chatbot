# =============================================================================
# Metabase Security Configuration
# =============================================================================
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env files with real secrets to version control

# -----------------------------------------------------------------------------
# Database Connection
# -----------------------------------------------------------------------------
MB_DB_TYPE=postgres
MB_DB_HOST=metabase-db
MB_DB_PORT=5432
MB_DB_DBNAME=metabase
MB_DB_USER=metabase
MB_DB_PASS=change-this-secure-password

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
MB_SITE_URL=https://metabase.yourdomain.com
MB_SITE_NAME=Accounting Analytics

# -----------------------------------------------------------------------------
# Security: Public Access (CRITICAL)
# -----------------------------------------------------------------------------
# Disable public sharing - prevents anonymous dashboard access
MB_ENABLE_PUBLIC_SHARING=false

# Disable native SQL queries for non-admin users (prevents SQL injection)
MB_NATIVE_QUERY_DISABLED=true

# -----------------------------------------------------------------------------
# Security: Session Management
# -----------------------------------------------------------------------------
# Session timeout in minutes (default: 20160 = 2 weeks)
# Recommended: 30-60 minutes for sensitive data
MB_SESSION_TIMEOUT=30

# Enable secure session cookies (requires HTTPS)
MB_SESSION_COOKIES=true

# -----------------------------------------------------------------------------
# Security: Password Policy
# -----------------------------------------------------------------------------
# Password complexity: weak, normal, strong
MB_PASSWORD_COMPLEXITY=strong

# Minimum password length
MB_PASSWORD_LENGTH=12

# -----------------------------------------------------------------------------
# Security: Embedding Configuration
# -----------------------------------------------------------------------------
# Enable embedding for dashboard integration
MB_ENABLE_EMBEDDING=true

# Embedding secret key (min 32 characters, generate with: openssl rand -hex 32)
MB_EMBEDDING_SECRET_KEY=generate-a-strong-random-key-min-32-chars

# -----------------------------------------------------------------------------
# Security: JWT Authentication
# -----------------------------------------------------------------------------
MB_JWT_ENABLED=true

# JWT shared secret (min 32 characters, generate with: openssl rand -hex 32)
MB_JWT_SHARED_SECRET=generate-a-strong-jwt-secret-min-32-chars

# JWT claim mappings
MB_JWT_ATTRIBUTE_EMAIL=email
MB_JWT_ATTRIBUTE_FIRSTNAME=first_name
MB_JWT_ATTRIBUTE_LASTNAME=last_name
MB_JWT_ATTRIBUTE_GROUPS=groups

# JWT identity provider URI (leave empty for custom implementation)
MB_JWT_IDENTITY_PROVIDER_URI=

# -----------------------------------------------------------------------------
# Security: HTTPS (Production Only)
# -----------------------------------------------------------------------------
# Redirect all HTTP requests to HTTPS
# MB_REDIRECT_ALL_REQUESTS_TO_HTTPS=true

# -----------------------------------------------------------------------------
# Security: Audit Logging
# -----------------------------------------------------------------------------
# Audit log retention in days
MB_AUDIT_MAX_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# Performance & Caching
# -----------------------------------------------------------------------------
MB_ENABLE_QUERY_CACHING=true
MB_QUERY_CACHING_MAX_TTL=300

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
JAVA_TIMEZONE=Asia/Ho_Chi_Minh

# -----------------------------------------------------------------------------
# Resource Limits (set in docker-compose.yml)
# -----------------------------------------------------------------------------
# Memory: 2G limit, 1G reservation
# CPU: 2 cores limit
