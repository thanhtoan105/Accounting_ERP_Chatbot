# =============================================================================
# Accounting System - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# =============================================================================
# Database Configuration
# =============================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/accounting_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres123

# =============================================================================
# Redis Configuration
# =============================================================================
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=your-secret-key-here-minimum-256-bits-change-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# =============================================================================
# Mail Configuration (MailDev for development)
# =============================================================================
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# =============================================================================
# Metabase Integration (Story 8-0)
# =============================================================================
# Metabase Site Configuration
METABASE_SITE_URL=http://localhost:3000

# Metabase Application Database (separate from accounting DB)
METABASE_DB_PASSWORD=metabase-app-db-password-change-in-production

# Embedding & JWT Authentication
# Generate with: openssl rand -base64 32
METABASE_EMBEDDING_SECRET=your-32-char-embedding-secret-change-in-production
METABASE_JWT_SECRET=your-32-char-jwt-secret-change-in-production

# Metabase Admin (bootstrap only - change password after first login)
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=initial-admin-password-change-immediately

# Metabase API Key (for provisioning automation)
# Generate after first admin login: Settings > Admin > API Keys
METABASE_API_KEY=your-metabase-api-key-for-provisioning

# Metabase Security Hardening
MB_ENABLE_PUBLIC_SHARING=false
MB_SESSION_TIMEOUT=30
MB_ENABLE_QUERY_CACHING=true
MB_CHECK_FOR_UPDATES=false

# =============================================================================
# Chatbot Configuration (Story 9-0) - NEW
# =============================================================================

# Feature Flag - Enable/disable chatbot functionality
CHATBOT_ENABLED=true

# Rate Limiting
CHATBOT_RATE_LIMIT_REQUESTS_PER_MINUTE=20

# Query Settings
CHATBOT_MAX_QUERY_LENGTH=5000
CHATBOT_CONFIDENCE_THRESHOLD=0.5

# =============================================================================
# Pinecone Configuration (Vector Database)
# =============================================================================
# Get these from: https://app.pinecone.io/ → API Keys
PINECONE_API_KEY=pcsk_XXXXXX_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=accounting-embeddings

# Vector Search Settings
PINECONE_TOP_K=10
PINECONE_SCORE_THRESHOLD=0.7
PINECONE_NAMESPACE_PREFIX=company

# Connection Settings
PINECONE_CONNECTION_TIMEOUT=10000
PINECONE_READ_TIMEOUT=30000

# =============================================================================
# Azure OpenAI Configuration (Embeddings & Chat Completions)
# =============================================================================
# OPTION A: Azure OpenAI (Recommended for production)
# Get these from: Azure Portal → Your OpenAI Resource → Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-35-turbo
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Model Settings
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_CHAT_MAX_TOKENS=500
AZURE_OPENAI_CHAT_TEMPERATURE=0.3

# Timeout Settings (milliseconds)
AZURE_OPENAI_CONNECTION_TIMEOUT=10000
AZURE_OPENAI_READ_TIMEOUT=60000

# =============================================================================
# OR OpenAI Configuration (Alternative to Azure OpenAI)
# =============================================================================
# OPTION B: OpenAI (Easier for MVP testing)
# Get this from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
# OPENAI_CHAT_MODEL=gpt-3.5-turbo

# =============================================================================
# n8n Webhook Configuration (Embedding Automation)
# =============================================================================
# Get this from: n8n workflow → Webhook node → Production URL
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/voucher-embedding
N8N_WEBHOOK_SECRET=your-webhook-secret-here-generate-random-string

# Retry Settings
N8N_WEBHOOK_RETRY_ENABLED=true
N8N_WEBHOOK_MAX_RETRIES=3
N8N_WEBHOOK_RETRY_DELAY_MS=1000,5000,15000

# Timeout Settings (milliseconds)
N8N_WEBHOOK_CONNECTION_TIMEOUT=10000
N8N_WEBHOOK_READ_TIMEOUT=30000

# =============================================================================
# Logging Configuration
# =============================================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ACCOUNTING=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG
